+def _profile_train_stages_enabled() -> bool:
+    return os.environ.get("RELAX_PROFILE_TRAIN_STAGES", "0").strip().lower() in {"1", "true", "yes", "on"}
+
+
+def _synchronized_stage_time() -> float:
+    """Return a wall-clock timestamp after completing queued CUDA work."""
+    if torch.cuda.is_available():
+        torch.cuda.synchronize()
+    return time.perf_counter()
+
+
+def _log_train_stage(rollout_id: int, step_id: int, stage: str, start_time: float) -> None:
+    elapsed = _synchronized_stage_time() - start_time
+    if not torch.distributed.is_initialized() or torch.distributed.get_rank() == 0:
+        logger.info(
+            "RELAX_TRAIN_STAGE rollout_id=%d step_id=%d stage=%s elapsed_s=%.6f",
+            rollout_id,
+            step_id,
+            stage,
+            elapsed,
+        )
+
